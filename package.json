{
  "name": "godel-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "npm run lint && npm run build",
    "types:supabase": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "test:e2e": "playwright test",
    "test:e2e:selfhosted": "node scripts/run-selfhosted-e2e.mjs",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:chromium:serial": "playwright test --project=chromium --workers=1",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "spike:ppo-03a2:local": "node scripts/spikes/ppo-03a2/run.mjs local",
    "spike:ppo-03a2:local:cleanup": "node scripts/spikes/ppo-03a2/local-policy.mjs cleanup",
    "spike:ppo-03a2:managed": "node scripts/spikes/ppo-03a2/run.mjs managed",
    "spike:ppo-03b1:local": "node scripts/spikes/ppo-03b1/run.mjs",
    "spike:ppo-03b1:cleanup": "node scripts/spikes/ppo-03b1/cleanup-orphans.mjs",
    "spike:ppo-03b2:managed": "node scripts/spikes/ppo-03b2/run.mjs",
    "spike:ppo-03c1:local": "node scripts/spikes/ppo-03c1/run.mjs",
    "spike:ppo-03c3:managed": "node scripts/spikes/ppo-03c3/run.mjs",
    "spike:ppo-03c3:cleanup": "node scripts/spikes/ppo-03c3/cleanup.mjs",
    "diff:check": "git diff --check",
    "ops:backup:selfhosted": "node scripts/operations/backup-selfhosted.mjs create",
    "ops:backup:selfhosted:verify": "node scripts/operations/backup-selfhosted.mjs verify",
    "qa:bootstrap": "node scripts/bootstrap-local-qa-users.mjs",
    "qa:bootstrap:selfhosted": "node scripts/bootstrap-local-qa-users.mjs --target self-hosted --runtime-env compose.env.local --qa-env .env.qa.local --supabase-env infra/supabase/.env",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:client-supabase": "node scripts/audit-client-supabase.mjs",
    "audit:public-tracking": "node scripts/audit-public-tracking.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
