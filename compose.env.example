# Este ejemplo no contiene credenciales. Copia los valores reales a una ubicación no versionada.
# Para ejecutar la app contenerizada contra Supabase local del host:
# SUPABASE_SERVER_URL=http://host.docker.internal:54321
# Supabase local está fuera de esta composición.
# Con Supabase administrado, normalmente SUPABASE_SERVER_URL puede dejarse vacío.
# La publishable key es pública, pero no debe reproducirse en documentación.
# SUPABASE_SECRET_KEY es server-only. El archivo real no debe versionarse.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_URL=
SUPABASE_SECRET_KEY=

GODEL_HTTP_BIND_ADDRESS=127.0.0.1
GODEL_HTTP_PORT=8080

GODEL_APP_IMAGE_TAG=ppo-02c2
GODEL_NGINX_IMAGE_TAG=ppo-02c2

GODEL_APP_CPUS=2.0
GODEL_APP_MEMORY_LIMIT=2g
GODEL_NGINX_CPUS=0.5
GODEL_NGINX_MEMORY_LIMIT=256m
