# Este ejemplo no contiene credenciales. Copia los valores reales a una ubicación no versionada.
# NEXT_PUBLIC_* se consume en build y runtime; ambos valores deben ser coherentes.
# SUPABASE_SERVER_URL y SUPABASE_SECRET_KEY son exclusivamente runtime/server-side.
# La publishable key es pública, pero no debe reproducirse en documentación.
# SUPABASE_SECRET_KEY es server-only. El archivo real no debe versionarse.
# SH-02.3: NEXT_PUBLIC_* values are public BUILD + RUNTIME configuration.
# They must match the build args; changing either requires an app rebuild.
# SUPABASE_SERVER_URL and SUPABASE_SECRET_KEY are RUNTIME SERVER-ONLY.
# URLs below are only the production-like local profile; PPO-04 replaces them.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_URL=http://api-gw:8000
SUPABASE_SECRET_KEY=

GODEL_HTTP_BIND_ADDRESS=127.0.0.1
GODEL_HTTP_PORT=8080

GODEL_APP_IMAGE_TAG=local
GODEL_NGINX_IMAGE_TAG=local

GODEL_APP_CPUS=2.0
GODEL_APP_MEMORY_LIMIT=2g
GODEL_NGINX_CPUS=0.5
GODEL_NGINX_MEMORY_LIMIT=256m
