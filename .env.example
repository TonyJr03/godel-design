# Do not commit `.env.local` to the repository.
# Do not use the Supabase service role key in frontend code.
# `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` is the public/publishable key for the Supabase project.
# For local development, copy the generated local value from `npx supabase status`.
# Supabase public keys do not replace Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# `SUPABASE_SECRET_KEY` is backend-only and must never use a `NEXT_PUBLIC` prefix.
# Local development should use `SECRET_KEY`; `SERVICE_ROLE_KEY` is a legacy local fallback.
# Production should prefer a Supabase secret key such as `sb_secret_...`.
# This key bypasses RLS, so never commit or paste a real value.
SUPABASE_SECRET_KEY=

# Optional server-only Supabase endpoint override.
# Do not add a `NEXT_PUBLIC` prefix.
# Leave empty to fall back to `NEXT_PUBLIC_SUPABASE_URL`.
# Useful for local container development when browser and server endpoints differ.
# Usually not needed with managed Supabase.
# Do not commit real private endpoints.
SUPABASE_SERVER_URL=

# QA local credentials only.
# Configure real local values in `.env.local`; never commit real QA credentials.
# Never use production or preproduction credentials here.
GODEL_TEST_ADMIN_EMAIL=
GODEL_TEST_ADMIN_PASSWORD=

GODEL_TEST_SUPERVISOR_EMAIL=
GODEL_TEST_SUPERVISOR_PASSWORD=

GODEL_TEST_WORKER_EMAIL=
GODEL_TEST_WORKER_PASSWORD=
